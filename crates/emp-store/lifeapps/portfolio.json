          },
          {
            "t": "kpi",
            "metric": "xirr_ytd",
            "label": "XIRR YTD",
            "format": "percent"
          },
          {
            "t": "kpi",
            "metric": "xirr_all",
            "label": "XIRR all-time",
            "format": "percent"
          },
          {
            "t": "kpi",
            "metric": "div_ttm",
            "label": "Dividends TTM",
            "format": "money"
          },
          {
            "t": "kpi",
            "metric": "div_fwd_12m",
            "label": "Dividends next 12 months",
            "format": "money"
          },
          {
            "t": "kpi",
            "metric": "max_drift",
            "label": "Max drift",
            "format": "number"
          },
          {
            "t": "kpi",
            "metric": "fees_per_year",
            "label": "Fees per year",
            "format": "money"
          },
          {
            "t": "chart",
            "db": "targets",
            "view": "chart",
            "title": "Target allocation"
          },
          {
            "t": "chart",
            "db": "dividends",
            "view": "by_month",
