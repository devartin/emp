  "advisor": [
    {
      "id": "drift-band",
      "when": "metrics.out_of_band_count > 0",
      "severity": "warn",
      "title": "{{metrics.out_of_band_count}} asset class(es) drifted outside their band",
      "body": "Max drift is {{metrics.max_drift}} percentage points. Consider directing new money to the underweight class first.",
      "mathMetrics": [
        "max_drift",
        "out_of_band_count"
      ],
      "actions": [
        {
          "label": "Rebalance planner",
          "route": "page:rebalance"
        }
      ]
    },
    {
      "id": "concentration-10",
      "when": "metrics.max_position_pct > 0.1",
      "severity": "tip",
      "title": "One position is {{fmt_pct(metrics.max_position_pct)}} of your portfolio",
      "body": "Positions above about 10% add single-company or single-fund risk. A broad fund counts as diversified, but check what it holds.",
      "mathMetrics": [
        "max_position_pct"
      ],
      "actions": [
        {
          "label": "Holdings",
          "route": "db:securities:all"
        }
      ]
    },
    {
      "id": "cash-drag",
      "when": "metrics.cash_pct > 0.05",
      "severity": "info",
      "title": "Cash is {{fmt_pct(metrics.cash_pct)}} of the portfolio",
      "body": "Cash above 5% for a long time can drag on returns. Consider whether it has a job (upcoming purchase, emergency fund).",
      "mathMetrics": [
        "cash_pct"
      ],
      "actions": [
        {
          "label": "Allocation",
          "route": "db:targets:all"
        }
      ]
    },
    {
      "id": "high-er",
      "when": "metrics.max_er > 0.5",
      "severity": "info",
      "title": "A fund charges {{metrics.max_er}}% a year",
      "body": "Expense ratios above 0.5% add up; low-cost index funds often charge under 0.1%. Fees per year: {{fmt_money(metrics.fees_per_year)}}.",
      "mathMetrics": [
        "max_er",
        "fees_per_year"
      ],
      "actions": [
        {
          "label": "Securities",
          "route": "db:securities:all"
        }
      ]
    },
    {
      "id": "stale-prices",
      "when": "metrics.price_age_days > 3",
      "severity": "info",
      "title": "Prices are {{metrics.price_age_days}} days old",
      "body": "Values use the last cached prices. Refresh market data to update them.",
      "mathMetrics": [
        "price_age_days"
      ],
      "actions": [
        {
          "label": "Markets",
          "route": "markets"
        }
      ]
    },
    {
      "id": "ips-review",
      "when": "metrics.days_since_install >= 365",
      "severity": "tip",
      "title": "Your yearly IPS review is due",
      "body": "Re-read your Investment Policy Statement and check that it still fits your goals.",
      "mathMetrics": [
        "days_since_install"
      ],
      "actions": [
        {
          "label": "Open IPS",
          "route": "page:ips"
        }
      ]
    },
    {
      "id": "harvest-review",
      "when": "metrics.month == 12 and metrics.taxable_losses < 0",
      "severity": "info",
      "title": "Tax-loss harvesting check",
      "body": "Taxable accounts hold {{fmt_money(metrics.taxable_losses)}} of unrealised losses. Selling before year-end may offset gains; watch wash-sale rules.",
      "mathMetrics": [
        "taxable_losses"
      ],
      "actions": [
        {
          "label": "Holdings",
          "route": "db:securities:all"
        }
      ]
    }
  ],
  "checklist": [
    {
      "id": "accounts",
