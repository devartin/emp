{
  "id": "portfolio",
  "version": "1.0.0",
  "title": "Portfolio",
  "tagline": "Track holdings, allocation and performance — with a plan for when markets fall.",
  "icon": "candlestick-chart",
  "color": "ocean",
  "category": "investing",
  "sensitivity": "high",
  "estMinutes": 7,
  "disclaimer": "Education and estimates, not investment advice. Example allocations are starting points, not recommendations. EMP never places trades.",
  "steps": [
    {
      "id": "experience",
      "kind": "choice_cards",
      "title": "How experienced are you with investing?",
      "quick": true,
      "skippable": false,
      "help": "This controls how much detail and jargon we show. Indicators appear at Advanced.",
      "default": "beginner",
      "options": [
        {
          "value": "beginner",
          "label": "Beginner",
          "description": "Keep it simple, explain terms."
        },
        {
          "value": "intermediate",
          "label": "Intermediate",
          "description": "I know funds and allocation."
        },
        {
          "value": "advanced",
          "label": "Advanced",
          "description": "Show indicators and lots."
        }
      ]
    },
    {
      "id": "accounts",
      "kind": "list_builder",
      "title": "Which investment accounts do you have?",
      "quick": true,
      "skippable": false,
      "help": "Account types come from your country's account pack (US: 401(k), IRA, Roth IRA, HSA, taxable, 529, crypto).",
      "default": [
        {
          "name": "Brokerage",
          "broker": "",
          "currency": "USD",
          "type": "taxable",
          "taxTreatment": "taxable"
        }
      ],
      "itemSchema": {
        "name": "text",
        "broker": "text",
        "currency": "text",
        "type": "enum(401k,403b,ira,roth_ira,hsa,taxable,529,crypto)",
        "taxTreatment": "enum(taxable,deferred,free)"
      }
    },
    {
      "id": "depth",
      "kind": "choice_cards",
      "title": "How much history do you want to track?",
      "quick": true,
      "skippable": true,
      "default": "positions",
      "options": [
        {
          "value": "positions",
          "label": "Positions only",
          "description": "Ticker, quantity and cost per position."
        },
        {
          "value": "history",
          "label": "Full history",
          "description": "Import a CSV of trades or enter them manually."
        }
      ]
    },
    {
      "id": "basis",
      "kind": "choice_cards",
      "title": "Cost-basis method",
      "quick": false,
      "skippable": true,
      "default": "fifo",
      "help": "Used to compute realised gains when you sell.",
      "options": [
        {
          "value": "fifo",
          "label": "FIFO",
          "description": "First in, first out (default)."
        },
        {
          "value": "average",
          "label": "Average cost"
        }
      ]
    },
    {
      "id": "risk",
      "kind": "choice_cards",
      "title": "Your risk profile",
      "quick": false,
      "skippable": true,
      "help": "Four quick questions give an educational stock/bond range — not a recommendation.",
      "default": {
        "horizon": "3to10",
        "drop": "hold",
        "income": "stable",
        "goal": "growth"
      },
      "recommend": "recommend_risk_range",
      "itemSchema": {
        "horizon": "enum(lt3,3to10,gt10)",
        "drop": "enum(sell,hold,buy)",
        "income": "enum(unstable,stable)",
        "goal": "text"
      }
    },
    {
      "id": "targets",
      "kind": "choice_cards",
      "title": "Pick a target allocation",
      "quick": true,
      "skippable": false,
      "help": "Each option is an example starting point, not a recommendation. Targets must add up to 100%.",
      "why": "A written target makes it easier to stay the course when markets move.",
      "recommend": "recommend_targets",
      "default": {
        "preset": "three_fund",
        "age": 40,
        "custom": []
      },
      "options": [
        {
          "value": "three_fund",
          "label": "Three-fund style",
          "description": "US stocks, international stocks, bonds."
        },
        {
          "value": "sixty_forty",
          "label": "60/40",
          "description": "60% stocks, 40% bonds."
        },
        {
          "value": "age_based",
          "label": "Age-based",
          "description": "110 − age in stocks."
        },
        {
          "value": "all_equity",
          "label": "All-equity",
          "description": "Stocks only — highest volatility."
        },
        {
          "value": "custom",
          "label": "Custom",
          "description": "Set your own classes and weights."
        }
      ],
      "itemSchema": {
        "class": "enum(us_equity,intl_developed,emerging,bonds,inflation_linked,reit,cash,crypto,other)",
        "target": "percent"
      }
    },
    {
      "id": "rebalance",
      "kind": "choice_cards",
      "title": "How do you want to rebalance?",
      "quick": false,
      "skippable": true,
      "recommend": "recommend_rebalance",
      "default": {
        "mode": "hybrid",
        "calendar": "annual",
        "bandAbs": 5,
        "bandRel": 25,
        "cashFlowFirst": true,
        "avoidTaxableSells": true,
        "minTrade": 50
      },
      "options": [
        {
          "value": "calendar",
          "label": "Calendar",
          "description": "Quarterly, semiannual or annual."
        },
        {
          "value": "threshold",
          "label": "Threshold",
          "description": "When a class drifts outside 5 pp / 25%."
        },
        {
          "value": "hybrid",
          "label": "Hybrid (default)",
          "description": "Check on a schedule, trade only outside the bands."
        }
      ]
    },
    {
      "id": "contrib",
      "kind": "money",
      "title": "Regular contributions",
      "quick": false,
      "skippable": true,
      "default": {
        "amount": 0,
        "rrule": "FREQ=MONTHLY;BYMONTHDAY=1",
        "accounts": []
      }
    },
    {
      "id": "market",
      "kind": "connect",
      "title": "Market data",
      "quick": true,
      "skippable": true,
      "help": "Only ticker symbols leave this device — never quantities, cost basis, account names or balances.",
      "default": {
        "provider": "keyless"
      },
      "options": [
        {
          "value": "keyless",
          "label": "Keyless (default)"
        },
        {
          "value": "keys",
          "label": "Use my provider keys"
        }
      ]
    },
    {
      "id": "watchlist",
      "kind": "list_builder",
      "title": "Watchlist",
      "quick": false,
      "skippable": true,
      "default": [],
      "itemSchema": {
        "ticker": "text",
        "alertAbove": "money",
        "alertBelow": "money",
        "alertPct": "percent"
      }
    },
    {
      "id": "benchmark",
      "kind": "choice_cards",
      "title": "Benchmark",
      "quick": false,
      "skippable": true,
      "default": {
        "kind": "blend"
      },
      "options": [
        {
          "value": "blend",
          "label": "Blend of my targets"
        },
        {
          "value": "symbol",
          "label": "A symbol (e.g. VT)"
        }
      ]
    }
  ],
  "templates": [
    {
