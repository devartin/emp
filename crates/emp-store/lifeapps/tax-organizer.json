  "advisor": [
    {
      "id": "deadline-3",
      "when": "metrics.days_to_next_deadline <= 3",
      "severity": "warn",
      "title": "A tax deadline is in {{metrics.days_to_next_deadline}} days",
      "body": "Next up: check the Deadlines page and finish what is left.",
      "mathMetrics": [
        "days_to_next_deadline"
      ],
      "actions": [
        {
          "label": "Deadlines",
          "route": "db:deadlines:upcoming"
        }
      ]
    },
    {
      "id": "deadline-14",
      "when": "metrics.days_to_next_deadline <= 14 and metrics.days_to_next_deadline > 3",
      "severity": "tip",
      "title": "A tax deadline is in {{metrics.days_to_next_deadline}} days",
      "body": "Plenty of time if you start now. Check which documents are still expected.",
      "mathMetrics": [
        "days_to_next_deadline"
      ],
      "actions": [
        {
          "label": "Deadlines",
          "route": "db:deadlines:upcoming"
        }
      ]
    },
    {
      "id": "doc-late",
      "when": "metrics.doc_late_count > 0",
      "severity": "tip",
      "title": "{{metrics.doc_late_count}} document(s) are late",
      "body": "Issuers usually send forms by their deadline; two weeks late is a good time to download them from the issuer's site or ask for a copy.",
      "mathMetrics": [
        "doc_late_count"
      ],
      "actions": [
        {
          "label": "Still expected",
          "route": "db:documents:missing"
        }
      ]
    },
    {
      "id": "se-no-estimates",
      "when": "answers.income_self_employment and metrics.quarterly_next > 1000 and metrics.estimates_paid_count == 0",
      "severity": "warn",
      "title": "Consider a quarterly estimated payment",
      "body": "Self-employment income suggests about {{fmt_money(metrics.quarterly_next)}} per quarter and no payment is recorded yet. Paying on time can avoid an underpayment penalty.",
      "mathMetrics": [
        "quarterly_next",
        "estimates_paid_count"
      ],
      "actions": [
        {
          "label": "Quarterly payments",
          "route": "page:quarterly"
        }
      ]
    },
    {
      "id": "itemize-close",
      "when": "metrics.standard_deduction > 0 and metrics.deductions_total >= 0.9 * metrics.standard_deduction",
      "severity": "info",
      "title": "Itemizing may beat the standard deduction",
      "body": "Deductions logged ({{fmt_money(metrics.deductions_total)}}) are within 10% of the standard deduction ({{fmt_money(metrics.standard_deduction)}}).",
      "mathMetrics": [
        "deductions_total",
        "standard_deduction"
      ],
      "actions": [
        {
          "label": "Estimator",
          "route": "page:estimator"
        }
      ]
    },
    {
      "id": "pack-stale",
      "when": "metrics.pack_stale",
      "severity": "warn",
      "title": "Tax rules may be out of date",
      "body": "The tax pack was verified a while ago or is for an earlier year. Estimates may be off until it is updated.",
      "mathMetrics": [],
      "actions": [
        {
          "label": "Settings",
          "route": "settings:updates"
        }
      ]
    },
    {
      "id": "receipt-missing",
      "when": "metrics.receipt_missing_count > 0",
      "severity": "tip",
      "title": "{{metrics.receipt_missing_count}} deduction(s) over $250 have no receipt",
      "body": "Gifts of $250 or more need a written acknowledgment; keep receipts for large business expenses too.",
      "mathMetrics": [
        "receipt_missing_count"
      ],
      "actions": [
        {
          "label": "Deductions",
          "route": "db:deductions:all"
        }
      ]
    },
    {
      "id": "setaside-short",
      "when": "coalesce(metrics.taxes_fund, -1) >= 0 and metrics.taxes_fund < metrics.est_balance",
      "severity": "info",
      "title": "Your Taxes fund is below the estimated balance due",
      "body": "Money HQ's Taxes fund holds {{fmt_money(metrics.taxes_fund)}}; the estimate is {{fmt_money(metrics.est_balance)}}. Consider topping it up.",
      "mathMetrics": [
        "taxes_fund",
        "est_balance"
      ],
      "actions": [
        {
          "label": "Estimator",
          "route": "page:estimator"
        }
      ]
    }
