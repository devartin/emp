            "name": "Description",
            "type": "title"
          },
          {
            "key": "date",
            "name": "Date",
            "type": "date"
          },
          {
            "key": "category",
            "name": "Category",
            "type": "select",
            "options": [
              {
                "key": "medical",
                "name": "Medical"
              },
              {
                "key": "charitable",
                "name": "Charitable"
              },
              {
                "key": "mortgage_interest",
                "name": "Mortgage interest"
              },
              {
                "key": "salt",
                "name": "State & local taxes"
              },
              {
                "key": "business_expense",
                "name": "Business expense"
              },
              {
                "key": "education",
                "name": "Education"
              },
              {
                "key": "childcare",
                "name": "Childcare"
              },
              {
                "key": "retirement",
                "name": "Retirement contribution"
              },
              {
                "key": "hsa",
                "name": "HSA contribution"
              },
              {
                "key": "home_office",
                "name": "Home office"
