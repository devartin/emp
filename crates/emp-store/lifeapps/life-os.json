      "key": "resources",
      "kind": "database",
      "optional": false,
      "spec": {
        "title": "Resources",
        "icon": "lucide:library",
        "properties": [
          {
            "key": "name",
            "name": "Name",
            "type": "title",
            "role": "resource.name"
          },
          {
            "key": "topic",
            "name": "Topic",
            "type": "text",
            "role": "resource.topic"
          },
          {
            "key": "url",
            "name": "Link",
            "type": "url",
            "role": "resource.url"
          },
          {
            "key": "area",
            "name": "Area",
            "type": "relation",
            "role": "resource.area",
            "relation": {
              "db": "areas",
              "limit": "one"
            }
          }
        ]
      },
      "when": "answers.style == \"para\" or answers.style == \"mix\""
    },
    {
      "key": "daily",
      "kind": "database",
      "optional": false,
