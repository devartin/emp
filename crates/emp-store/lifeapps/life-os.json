            "role": "area.standard",
            "description": "What “good” looks like in this area."
          },
          {
            "key": "icon",
            "name": "Icon",
            "type": "text",
            "role": "area.icon"
          }
        ],
        "rows": [
          {
            "key": "work",
            "when": "answers.areas_work",
            "icon": "lucide:briefcase",
            "values": {
              "name": "Work"
            }
          },
          {
