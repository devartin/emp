            "values": {
              "name": "Health"
            }
          },
          {
            "key": "money",
            "when": "answers.areas_money",
            "icon": "lucide:piggy-bank",
            "values": {
              "name": "Money"
            }
          },
          {
            "key": "home",
            "when": "answers.areas_home",
            "icon": "lucide:house",
            "values": {
              "name": "Home"
            }
          },
          {
            "key": "relationships",
            "when": "answers.areas_relationships",
            "icon": "lucide:heart",
            "values": {
              "name": "Relationships"
            }
          },
          {
            "key": "learning",
            "when": "answers.areas_learning",
            "icon": "lucide:library",
            "values": {
              "name": "Learning"
            }
          },
          {
            "key": "fun",
            "when": "answers.areas_fun",
            "icon": "lucide:party-popper",
            "values": {
              "name": "Fun"
            }
          },
          {
            "key": "side_project",
            "when": "answers.areas_side_project",
            "icon": "lucide:rocket",
            "values": {
              "name": "Side project"
            }
          },
          {
            "key": "family",
            "when": "answers.areas_family",
            "icon": "lucide:users",
            "values": {
              "name": "Family"
            }
          },
          {
            "key": "community",
            "when": "answers.areas_community",
            "icon": "lucide:handshake",
            "values": {
              "name": "Community"
            }
          }
        ]
