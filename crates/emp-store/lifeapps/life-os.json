      "skippable": false,
      "default": [
        "work",
        "health",
        "home"
      ],
      "options": [
        {
          "value": "work",
          "label": "Work"
        },
        {
          "value": "health",
          "label": "Health"
        },
        {
          "value": "money",
          "label": "Money"
        },
        {
          "value": "home",
          "label": "Home"
        },
        {
          "value": "relationships",
          "label": "Relationships"
        },
        {
          "value": "learning",
          "label": "Learning"
        },
        {
          "value": "fun",
          "label": "Fun"
        },
        {
          "value": "side_project",
          "label": "Side project"
        },
        {
          "value": "family",
          "label": "Family"
        },
        {
          "value": "community",
          "label": "Community"
        }
      ]
    },
    {
      "id": "priority",
      "kind": "choice_cards",
      "title": "How do you prioritise?",
      "quick": false,
      "skippable": true,
      "default": "p1_p4",
      "options": [
        {
          "value": "p1_p4",
          "label": "P1–P4"
        },
        {
          "value": "eisenhower",
          "label": "Eisenhower matrix",
          "description": "Urgent × important."
        },
        {
          "value": "top3",
          "label": "Top 3 per day"
