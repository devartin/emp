      "skippable": false,
      "recommend": "recommend_lifeos_style",
      "default": "simple",
      "options": [
        {
          "value": "simple",
          "label": "Simple",
          "description": "Today and Upcoming."
        },
        {
          "value": "gtd",
          "label": "GTD",
          "description": "Inbox, next actions, weekly review."
        },
        {
          "value": "time_blocking",
          "label": "Time-blocking",
          "description": "Give tasks a place on the calendar."
        },
        {
          "value": "para",
          "label": "PARA",
          "description": "Projects, Areas, Resources, Archive."
        },
        {
          "value": "mix",
          "label": "Mix",
          "description": "A bit of everything."
        }
      ]
    },
    {
      "id": "areas",
      "kind": "multi_chips",
      "title": "Which areas of life do you want to manage?",
