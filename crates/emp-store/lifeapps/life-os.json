      "default": {
        "days": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri"
        ],
        "start": "09:00",
        "end": "17:30",
        "focus": "09:00-11:30",
        "maxFocusBlocks": 2
      },
      "itemSchema": {
        "days": "multi",
        "start": "time",
        "end": "time",
        "focus": "text",
        "maxFocusBlocks": "number"
      }
    },
    {
      "id": "calendar",
      "kind": "connect",
      "title": "Show your Google Calendar?",
      "quick": false,
      "skippable": true,
      "default": {
        "connect": false,
        "calendars": []
      },
      "help": "Read-only. Events appear on the Today timeline."
    },
    {
      "id": "rituals",
      "kind": "recurrence",
      "title": "Planning rituals",
      "quick": true,
      "skippable": true,
      "why": "A daily plan and a weekly review are the habits that keep a task system trusted.",
      "default": {
        "daily": {
          "rrule": "FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR",
          "time": "08:30"
        },
        "shutdown": {
          "rrule": "FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR",
          "time": "17:30"
        },
        "weekly": {
          "rrule": "FREQ=WEEKLY;BYDAY=FR",
          "time": "16:00"
        },
        "monthly": {
          "rrule": "FREQ=MONTHLY;BYMONTHDAY=1",
          "time": "09:00"
        }
      }
    },
    {
      "id": "capture",
      "kind": "toggle",
      "title": "Quick capture",
      "quick": false,
      "skippable": true,
      "default": {
        "nlDates": true
      },
      "help": "Type “call Sam tomorrow 3pm #home” and dates are understood. A global capture hotkey is not part of this version."
    },
    {
      "id": "review",
      "kind": "review",
      "title": "Review and create",
      "quick": true,
      "skippable": false
    }
  ],
  "templates": [
    {
      "key": "today",
      "kind": "dashboard",
      "optional": false,
      "spec": {
        "title": "Tasks",
        "icon": "lucide:kanban",
        "subtitle": "Tasks, lists and goals.",
        "tabs": [
          "Tasks",
          "Lists",
          "Review"
        ],
        "tiles": [
          {
            "t": "kpi",
            "metric": "inbox_count",
            "label": "Inbox",
            "format": "number"
          },
          {
            "t": "kpi",
            "metric": "overdue_count",
            "label": "Overdue",
            "format": "number"
          },
          {
            "t": "kpi",
            "metric": "today_scheduled_min",
            "label": "Scheduled today (min)",
            "format": "number"
          },
          {
            "t": "kpi",
            "metric": "projects_without_next",
            "label": "Lists without a next action",
            "format": "number"
          }
        ],
        "blocks": [
          {
            "t": "md",
            "md": "## Due"
          },
          {
            "t": "database",
            "db": "tasks",
            "view": "today"
          },
          {
            "t": "md",
            "md": "## Inbox"
          },
          {
            "t": "database",
            "db": "tasks",
            "view": "inbox"
          },
          {
            "t": "md",
            "md": "## Method"
          },
          {
            "t": "pageLink",
            "page": "method"
          },
          {
            "t": "pageLink",
            "page": "weekly"
          }
        ]
      }
    },
    {
      "key": "method",
      "kind": "page",
      "optional": false,
      "spec": {
        "title": "How Tasks works",
        "icon": "lucide:brain",
        "blocks": [
          {
            "t": "md",
            "md": "## Capture everything\nAnything on your mind goes to the **Inbox**. Quick add understands dates like “tomorrow 3pm” and tags like `#home`. Capturing is not committing; it gets things out of your head.\n\n## Clarify and organise\nWhen you process the inbox, decide for each item:\n- **Is it actionable?** No → delete it, file it as a resource, or move it to *Someday*.\n- **Takes under two minutes?** Do it now.\n- **Waiting on someone?** Status *Waiting*, and note who.\n- **Has a date?** Give it a *Due* date only when there is a real deadline; use *Scheduled* for when you plan to do it.\n- **More than one step?** It is a **list**: give it an outcome and one *Next* action.\n\n## Prioritise\n{{if(answers.priority == \"eisenhower\", \"You chose the Eisenhower matrix: do urgent + important now, schedule important, delegate urgent, drop the rest. The Eisenhower board groups tasks by quadrant.\", if(answers.priority == \"top3\", \"You chose Top 3 per day: pick the three tasks that would make today a success in your morning plan; everything else is a bonus.\", \"You chose P1–P4: P1 is today-critical, P2 this week, P3 soon, P4 whenever. Keep P1 to a handful.\"))}}\n\n## Plan the day, then shut down\nEach morning look at **Due** in Tasks, choose your top 3 and give focus work a time block. At the end of the day run the shutdown checklist so work stays at work.\n\n## Weekly review\nOnce a week: get clear (inbox to zero), get current (calendar, lists without a next action, waiting list) and get creative (someday list). This is what keeps the system trusted."
          }
        ]
      }
    },
    {
      "key": "weekly",
      "kind": "page",
      "optional": false,
      "spec": {
        "title": "Weekly review",
        "icon": "lucide:repeat",
        "template": true,
        "blocks": [
          {
            "t": "md",
            "md": "## 1. Get clear"
          },
          {
            "t": "checklist",
            "items": [
              "Inbox to zero",
              "Empty notebooks, email flags and downloads into the inbox"
            ]
          },
          {
            "t": "md",
            "md": "## 2. Get current"
          },
          {
            "t": "checklist",
            "items": [
              "Review the calendar: past week and next two weeks",
              "Every active list has a Next action",
              "Check the Waiting list and follow up",
              "Read this week's insights"
            ]
          },
          {
            "t": "database",
            "db": "projects",
            "view": "active"
          },
          {
            "t": "database",
            "db": "tasks",
            "view": "waiting"
          },
          {
            "t": "md",
            "md": "## 3. Get creative"
          },
          {
            "t": "checklist",
            "items": [
              "Review the Someday list: promote or delete",
              "Choose next week's top 3"
            ]
          },
          {
            "t": "database",
            "db": "tasks",
            "view": "someday"
          }
        ]
      }
    },
    {
      "key": "tasks",
      "kind": "database",
      "optional": false,
      "spec": {
        "title": "Tasks",
        "icon": "lucide:circle-check",
        "properties": [
          {
            "key": "title",
            "name": "Title",
            "type": "title",
            "role": "task.title"
          },
          {
            "key": "status",
            "name": "Status",
            "type": "status",
            "role": "task.status",
            "options": [
              {
                "key": "inbox",
                "name": "Inbox",
                "color": "gray",
                "group": "todo"
              },
              {
                "key": "next",
                "name": "Next",
                "color": "blue",
                "group": "todo"
              },
              {
                "key": "scheduled",
                "name": "Scheduled",
                "color": "purple",
                "group": "in_progress"
              },
              {
                "key": "waiting",
                "name": "Waiting",
                "color": "yellow",
                "group": "in_progress"
              },
              {
                "key": "someday",
                "name": "Someday",
                "color": "brown",
                "group": "todo"
              },
              {
                "key": "done",
                "name": "Done",
                "color": "green",
                "group": "complete"
              }
            ]
          },
          {
            "key": "priority",
            "name": "Priority",
            "type": "select",
            "role": "task.priority",
            "options": [
              {
                "key": "p1",
                "name": "P1",
                "color": "red"
              },
              {
                "key": "p2",
                "name": "P2",
                "color": "orange"
              },
              {
                "key": "p3",
                "name": "P3",
                "color": "blue"
              },
              {
                "key": "p4",
                "name": "P4",
                "color": "gray"
              }
            ]
          },
          {
            "key": "quadrant",
            "name": "Quadrant",
            "type": "select",
            "role": "task.quadrant",
            "options": [
              {
                "key": "do",
                "name": "Do now (urgent, important)",
                "color": "red"
              },
              {
                "key": "schedule",
                "name": "Schedule (important)",
                "color": "blue"
              },
              {
                "key": "delegate",
                "name": "Delegate (urgent)",
                "color": "yellow"
              },
              {
                "key": "drop",
                "name": "Drop (neither)",
                "color": "gray"
              }
            ]
          },
          {
            "key": "due",
            "name": "Due",
            "type": "date",
            "role": "task.due"
          },
          {
            "key": "scheduled",
            "name": "Scheduled",
            "type": "date",
            "role": "task.scheduled"
          },
          {
            "key": "estimate",
            "name": "Estimate (min)",
            "type": "number",
            "role": "task.estimate"
          },
          {
            "key": "area",
            "name": "Area",
            "type": "relation",
            "role": "task.area",
            "relation": {
              "db": "areas",
              "limit": "one",
              "dual": {
                "key": "tasks",
                "name": "Tasks"
              }
            }
          },
          {
            "key": "project",
            "name": "List",
            "type": "relation",
            "role": "task.project",
            "relation": {
              "db": "projects",
              "limit": "one",
              "dual": {
                "key": "tasks",
                "name": "Tasks"
              }
            }
          },
          {
            "key": "context",
            "name": "Context",
            "type": "multi_select",
            "role": "task.context",
            "options": [
              {
                "key": "home",
                "name": "@home"
              },
              {
                "key": "computer",
                "name": "@computer"
              },
              {
                "key": "errands",
                "name": "@errands"
              },
              {
                "key": "calls",
                "name": "@calls"
              }
            ]
          },
          {
            "key": "energy",
            "name": "Energy",
            "type": "select",
            "role": "task.energy",
            "options": [
              {
                "key": "high",
                "name": "High"
              },
              {
                "key": "medium",
                "name": "Medium"
              },
              {
                "key": "low",
                "name": "Low"
              }
            ]
          },
          {
            "key": "recurrence",
            "name": "Recurrence",
            "type": "recurrence",
            "role": "task.recurrence"
          },
          {
            "key": "waiting_on",
            "name": "Waiting on",
            "type": "text",
            "role": "task.waiting"
          },
          {
            "key": "source",
            "name": "Source",
            "type": "text",
            "role": "task.source"
          },
          {
            "key": "completed_at",
            "name": "Completed at",
            "type": "date",
            "role": "task.completed"
          },
          {
            "key": "done_flag",
            "name": "Done",
            "type": "checkbox",
            "role": "task.done",
            "hidden": true
          },
          {
            "key": "top3",
            "name": "Top 3",
            "type": "checkbox",
            "role": "task.top3",
            "description": "Starred for today; shows on Home."
          }
        ],
        "views": [
          {
            "key": "inbox",
            "name": "Inbox",
            "layout": "list",
            "filter": {
              "prop": "status",
              "op": "eq",
              "value": "opt:inbox"
            },
            "sorts": [
              {
                "prop": "$created",
                "dir": "desc"
              }
            ]
          },
          {
            "key": "today",
            "name": "Due",
            "layout": "table",
            "filter": {
              "and": [
                {
                  "prop": "status",
                  "op": "neq",
                  "value": "opt:done"
                },
                {
                  "or": [
                    {
                      "prop": "scheduled",
                      "op": "on_or_before",
                      "value": "today"
                    },
                    {
                      "prop": "due",
                      "op": "on_or_before",
                      "value": "today"
                    }
                  ]
                }
              ]
            },
            "sorts": [
              {
                "prop": "priority",
                "dir": "asc"
              }
            ]
          },
          {
            "key": "upcoming",
            "name": "Upcoming",
            "layout": "calendar",
            "calendar": {
              "dateProp": "due"
            }
          },
          {
            "key": "board",
            "name": "Board",
            "layout": "board",
            "groupBy": {
              "prop": "status"
            }
          },
          {
            "key": "eisenhower",
            "name": "Eisenhower",
            "layout": "board",
            "groupBy": {
              "prop": "quadrant"
            }
          },
          {
            "key": "someday",
            "name": "Someday",
            "layout": "list",
            "filter": {
              "prop": "status",
              "op": "eq",
              "value": "opt:someday"
            }
          },
          {
            "key": "waiting",
            "name": "Waiting",
            "layout": "table",
            "filter": {
              "prop": "status",
              "op": "eq",
              "value": "opt:waiting"
            }
          },
          {
            "key": "completed",
            "name": "Completed",
            "layout": "table",
            "filter": {
              "prop": "status",
              "op": "eq",
              "value": "opt:done"
            },
            "sorts": [
              {
                "prop": "completed_at",
                "dir": "desc"
              }
            ]
          }
        ],
        "rowTemplates": [
          {
            "key": "task",
            "name": "Task",
            "default": true,
            "values": {
              "status": "inbox"
            }
          }
        ]
      }
    },
    {
      "key": "projects",
      "kind": "database",
      "optional": false,
      "spec": {
        "title": "Lists",
        "icon": "lucide:folder",
        "properties": [
          {
            "key": "name",
            "name": "Name",
            "type": "title",
            "role": "project.name"
          },
          {
            "key": "area",
            "name": "Area",
            "type": "relation",
            "role": "project.area",
            "relation": {
              "db": "areas",
              "limit": "one"
            }
          },
          {
            "key": "status",
            "name": "Status",
            "type": "select",
            "role": "project.status",
            "options": [
              {
                "key": "active",
                "name": "Active",
                "color": "blue"
              },
              {
                "key": "on_hold",
                "name": "On hold",
                "color": "yellow"
              },
              {
                "key": "done",
                "name": "Done",
                "color": "green"
              },
              {
                "key": "archived",
                "name": "Archived",
                "color": "gray"
              }
            ]
          },
          {
            "key": "outcome",
            "name": "Outcome",
            "type": "text",
            "role": "project.outcome",
            "description": "What does done look like?"
          },
          {
            "key": "deadline",
            "name": "Deadline",
            "type": "date",
            "role": "project.deadline"
          },
          {
            "key": "progress",
            "name": "Progress",
            "type": "rollup",
            "role": "project.progress",
            "rollup": {
              "relation": "tasks",
              "target": "done_flag",
              "fn": "pct_checked"
            }
          },
          {
            "key": "next_action",
            "name": "Next action",
            "type": "formula",
            "role": "project.next",
            "formula": "prop(\"Tasks\").filter(current.prop(\"Status\") == \"Next\").map(current.prop(\"Title\")).first()"
          },
          {
            "key": "review",
            "name": "Review date",
            "type": "date",
            "role": "project.review"
          }
        ],
        "views": [
          {
            "key": "active",
            "name": "Active",
            "layout": "board",
            "groupBy": {
              "prop": "status"
            }
          },
          {
            "key": "all",
            "name": "All",
            "layout": "table",
            "sorts": [
              {
                "prop": "deadline",
                "dir": "asc"
              }
            ]
          }
        ]
      }
    },
    {
