{
  "id": "life-os",
  "version": "1.0.0",
  "title": "Tasks",
  "tagline": "Tasks, lists and a daily plan.",
  "icon": "kanban",
  "color": "blue",
  "category": "planning",
  "sensitivity": "normal",
  "estMinutes": 4,
  "steps": [
