{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMP",
  "version": "../package.json",
  "identifier": "com.devartin.emp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "EMP",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "devtools": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ],
    "security": {
      "pattern": {
        "use": "isolation",
        "options": { "dir": "../src-tauri/isolation" }
      },
      "freezePrototype": true,
      "assetProtocol": { "enable": false },
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: emp-asset: http://emp-asset.localhost",
        "media-src": "'self' blob: emp-asset: http://emp-asset.localhost",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "child-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "manifest-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "script-src": "'self' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: emp-asset: http://emp-asset.localhost http://localhost:1420",
        "media-src": "'self' blob: emp-asset: http://emp-asset.localhost",
        "font-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "child-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "manifest-src": "'none'"
      },
      "capabilities": ["main", "settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local-first, encrypted productivity super app",
    "longDescription": "EMP keeps your notes, databases, spreadsheets and finances on your computer, optionally encrypted with 256-bit XChaCha20-Poly1305 under a key protected by your password using Argon2id.",
    "copyright": "Copyright (c) devartin. MIT License.",
    "publisher": "devartin",
    "homepage": "https://github.com/devartin/emp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "en-US" }
    },
    "linux": {
      "deb": { "depends": [] },
      "rpm": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
